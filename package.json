  "scripts": {
    "build": "nest build",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "migration:run": "prisma migrate deploy",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "typecheck": "bun node_modules/tsgo/bin/tsc --noEmit",
    "test": "bun test src",
    "test:watch": "bun --watch test src",
    "test:cov": "bun test src --coverage",
    "test:debug": "bun --inspect-brk test src",
    "test:e2e": "bun test test"
  },
  "dependencies": {
